{
  "description": "Inject Cairn's always-current project context (.agent/CONTEXT.md) at session start, so the agent is oriented in one cheap read.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PROJECT_DIR}/.agent/CONTEXT.md\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PROJECT_DIR}/.agent/CONTEXT.md\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
